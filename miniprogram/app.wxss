  right: 30rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  z-index: 9;
}

.profile-hero {
  border-radius: 18rpx;
  box-shadow: var(--paper-shadow);
}

.profile-hero::before {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 42rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}

.awning {
  position: absolute;
  z-index: 1;
  right: 44rpx;
  top: 48rpx;
  display: grid;
  grid-template-columns: repeat(4, 36rpx);
  height: 84rpx;
  border-radius: 8rpx 8rpx 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 14rpx rgba(8, 48, 35, 0.15);
}

.awning view {
  background: #ffffff;
}

.awning view:nth-child(2n) {
  background: var(--market-yellow);
}

.campus-line {
  bottom: 58rpx;
  border-color: rgba(255, 255, 255, 0.34);
  background:
    linear-gradient(
      90deg,
      transparent 0,
      transparent 28%,
      rgba(255,255,255,0.22) 28%,
      rgba(255,255,255,0.22) 31%,
      transparent 31%,
      transparent 58%,
      rgba(255,255,255,0.22) 58%,
      rgba(255,255,255,0.22) 61%,
      transparent 61%
    ),
    linear-gradient(
      0deg,
      rgba(255,255,255,0.18) 0,
      rgba(255,255,255,0.18) 12rpx,
      transparent 12rpx
    );
}

.stall-sign {
  right: 74rpx;
  bottom: 102rpx;
  padding: 8rpx 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 8rpx;
}

.profile-section {
  position: relative;
}

.profile-section::before {
  content: "";
  position: absolute;
  left: 28rpx;
  top: -12rpx;
  width: 92rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: rgba(255, 224, 128, 0.64);
  transform: rotate(-4deg);
}

/* ===== P0 Redesign Utilities ===== */
.cart-page {
  padding-bottom: 190rpx;
}

.cart-item {
  align-items: stretch;
}

.price-sm {
  font-size: 32rpx;
}

.price-block {
  display: block;
}

.stepper {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-full);
  background: var(--card);
}

.step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-height: 60rpx;
  color: var(--primary);
  font-size: var(--fs-lg);
  font-weight: 800;
}

.step-val {
  min-width: 52rpx;
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 700;
  text-align: center;
}

.chat-buy-action {
  min-height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
