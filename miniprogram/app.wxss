/* ===== Product Card ===== */
.product-rail {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 0 18rpx;
}

.product-card {
  position: relative;
  display: inline-flex;
  width: 300rpx;
  min-height: 420rpx;
  flex-direction: column;
  gap: 18rpx;
  vertical-align: top;
  margin-right: 18rpx;
  padding: 12rpx;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(63, 49, 30, 0.16);
  overflow: visible;
  transform: rotate(-0.8deg);
}

.product-card:nth-child(2n) {
  transform: rotate(0.7deg);
}

.card-tape {
  position: absolute;
  z-index: 3;
  left: 88rpx;
  top: -14rpx;
  width: 112rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: rgba(255, 224, 128, 0.72);
  transform: rotate(-5deg);
}

.product-img {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  color: #FFFFFF;
  font-size: var(--fs-xs);
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  background: linear-gradient(160deg, var(--market-deep), var(--market-green));
}

.product-card .product-img {
  width: 100%;
  height: 208rpx;
  border: 10rpx solid #ffffff;
  border-radius: 10rpx;
  box-shadow: inset 0 -20rpx 0 rgba(255, 255, 255, 0.16), 0 6rpx 12rpx rgba(67, 51, 28, 0.12);
  box-sizing: border-box;
}

.product-card .product-img::before {
  content: "";
  position: absolute;
  inset: 18rpx;
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.24), transparent 42%),
    linear-gradient(0deg, rgba(8, 114, 77, 0.18), transparent 44%);
}

.product-card .product-img text {
  position: relative;
  z-index: 2;
  margin-top: auto;
  color: rgba(255, 255, 255, 0.94);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.12);
}

.product-photo {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.product-img.book {
  background: linear-gradient(160deg, var(--market-deep), var(--market-green));
}

.product-img.digital {
  background: linear-gradient(145deg, var(--market-blue), #9fc6e8);
}

.product-img.life {
  background: linear-gradient(145deg, #f0b943, var(--market-yellow));
}

.product-img.sport {
  background: linear-gradient(160deg, var(--market-red), #f4a09a);
}

.product-img .product-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: var(--radius-sm);
  color: var(--market-deep);
  background-color: rgba(255, 255, 255, 0.92);
  font-size: 34rpx;
  font-weight: 700;
  position: relative;
  z-index: 2;
  background-size: 58rpx 58rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-info .title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-info .row {
  align-items: flex-start;
}

.seller-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  margin-top: auto;
}

.seller-tag {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.seller-tag.name {
  color: var(--market-deep);
  background: var(--primary-bg);
}

.seller-tag.cat {
  color: var(--text-muted);
  background: var(--fill);
}

/* ===== Bottom Action Bar ===== */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx var(--space-3);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(247, 243, 232, 0.96);
  box-shadow: 0 -10rpx 28rpx rgba(48, 65, 55, 0.08);
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 60rpx 30rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  text-align: center;
}

.empty-state .empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  color: var(--market-deep);
  background-color: #fff4cb;
  background-size: 48rpx 48rpx;
  font-size: var(--fs-xl);
  font-weight: 700;
}

.empty-state .empty-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
}

.empty-state .empty-desc {
  max-width: 440rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

/* ===== Status Tabs ===== */
.status-tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.status-tabs .tab {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-full);
  color: var(--text-muted);
  background: var(--card);
  font-weight: 600;
  font-size: 26rpx;
}

.status-tabs .tab.active {
  color: #FFFFFF;
  background: var(--market-deep);
  border-color: var(--market-deep);
}

/* ===== Filter Chip Row ===== */
.filter-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.filter-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-full);
  background: var(--card);
  font-size: var(--fs-sm);
  font-weight: 600;
  justify-content: center;
}

.filter-chip .chip-label {
  color: var(--text-muted);
  font-size: var(--fs-xs);
}

.filter-chip .chip-value {
  color: var(--text);
  font-size: var(--fs-sm);
  font-weight: 700;
}

.filter-chip.active {
  border-color: var(--market-deep);
  background: #e8f6ee;
  color: var(--market-deep);
}

.filter-reset {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-full);
  background: var(--card);
  color: var(--text-muted);
  font-weight: 600;
  font-size: var(--fs-sm);
}

/* ===== Banner ===== */
.banner {
  padding: 28rpx;
  border-radius: var(--radius-md);
  color: #FFFFFF;
  background: var(--market-deep);
  position: relative;
  overflow: hidden;
}

.banner .banner-kicker {
  display: inline-flex;
  margin-bottom: var(--space-2);
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: rgba(255,255,255,0.9);
}

.banner-title {
  display: block;
  margin: 0;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.banner-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.55;
}

/* Market Hero (首页卡片式) */
.market-hero {
  position: relative;
  min-height: 430rpx;
  padding: 28rpx 24rpx 26rpx;
  border: 0;
  border-radius: 10rpx;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(98, 58, 26, 0.12) 0,
      rgba(98, 58, 26, 0.12) 2rpx,
      transparent 2rpx,
      transparent 86rpx
    ),
    linear-gradient(120deg, #bd8951, #d3a36b 48%, #9d6638);
  box-shadow: 0 12rpx 22rpx rgba(78, 53, 28, 0.18);
  overflow: hidden;
}

.market-hero::before {
  content: "";
  position: absolute;
  inset: 14rpx;
  border-radius: 6rpx;
  border: 4rpx solid rgba(92, 54, 25, 0.18);
  box-shadow: inset 0 -8rpx 0 rgba(81, 47, 21, 0.16);
}

.board-grain {
  position: absolute;
  inset: 12rpx;
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(82, 48, 22, 0.12) 1rpx, transparent 1rpx),
    radial-gradient(circle at 30% 42%, rgba(92, 52, 22, 0.18), transparent 12%);
  background-size: 92rpx 100%, 100% 100%;
}

.market-hero .banner-kicker {
  color: var(--market-deep);
  border-color: rgba(12, 92, 66, 0.18);
  background: rgba(232, 246, 238, 0.82);
  font-size: 24rpx;
  font-weight: 900;
}

.market-hero-title {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-green);
  font-size: 76rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
}

.market-hero-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--text-muted);
  opacity: 1;
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.hero-chips .chip {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  color: var(--market-deep);
  background: #fff4cb;
  font-size: var(--fs-xs);
  font-weight: 600;
}

.pin {
  position: absolute;
  z-index: 3;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: 0 6rpx 10rpx rgba(27, 29, 20, 0.26);
}

.pin.green {
  top: 20rpx;
  left: 44%;
  background: var(--market-green);
}

.pin.yellow {
  top: 42rpx;
  right: 78rpx;
  background: var(--market-yellow);
}

.torn-sheet {
  position: relative;
  z-index: 2;
  width: 78%;
  min-height: 300rpx;
  padding: 44rpx 40rpx 36rpx 70rpx;
  border-radius: 8rpx 18rpx 10rpx 22rpx;
  box-sizing: border-box;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.88), rgba(251, 247, 235, 0.96)),
    var(--market-panel);
  box-shadow: 0 10rpx 22rpx rgba(60, 43, 26, 0.15);
  transform: rotate(-1.4deg);
}

.torn-sheet::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -10rpx;
  height: 20rpx;
  background: repeating-linear-gradient(
    135deg,
    rgba(255, 253, 246, 0.95) 0,
    rgba(255, 253, 246, 0.95) 18rpx,
    transparent 18rpx,
    transparent 30rpx
  );
}

.paper-holes {
  position: absolute;
  left: 16rpx;
  top: 28rpx;
  bottom: 24rpx;
  width: 24rpx;
  border-radius: 999rpx;
  background: repeating-linear-gradient(
    to bottom,
    rgba(123, 98, 64, 0.26) 0,
    rgba(123, 98, 64, 0.26) 14rpx,
    transparent 14rpx,
    transparent 34rpx
  );
}

.hero-doodle {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  width: 58rpx;
  height: 58rpx;
  color: var(--ink-green);
  font-size: 50rpx;
  transform: rotate(-12deg);
}

.paint-strip {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  min-height: 58rpx;
  padding: 0 28rpx;
  color: var(--ink-green);
  background: linear-gradient(90deg, #ffe37b, var(--market-yellow));
  border-radius: 6rpx;
  font-size: 34rpx;
  font-weight: 900;
  transform: rotate(-1.6deg);
}

.photo-note,
.sticky-note {
  position: absolute;
  z-index: 3;
  right: 24rpx;
  color: var(--ink-green);
  box-shadow: 0 8rpx 16rpx rgba(55, 42, 22, 0.16);
}

.photo-note {
  top: 48rpx;
  right: 18rpx;
  width: 158rpx;
  height: 138rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 14rpx 12rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 8rpx solid #ffffff;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 800;
  transform: rotate(8deg);
}

.photo-note::before {
  display: none;
}

.note-illustration {
  width: 108rpx;
  height: 62rpx;
}

.sticky-note {
  right: 30rpx;
  bottom: 34rpx;
  width: 144rpx;
  min-height: 118rpx;
  padding: 20rpx 14rpx;
  box-sizing: border-box;
  background: #c6e978;
  border-radius: 4rpx;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  transform: rotate(-4deg);
}

.sticky-icon {
  width: 56rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}

.sticky-note text,
.trust-sticker text,
.stall-sign text {
  display: block;
}

.market-note,
.publish-strip {
  position: relative;
  padding: 22rpx 26rpx;
  border: 1rpx solid #e6d7b3;
  border-radius: 12rpx;
  background: rgba(255, 252, 242, 0.92);
  box-shadow: var(--paper-shadow);
}

.publish-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-style: dashed;
}

.publish-title {
  display: block;
  color: var(--ink-green);
  font-size: 32rpx;
  font-weight: 900;
}

.bottom-publish-strip {
  align-items: center;
  min-height: 128rpx;
  margin-top: 4rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #eadfc8;
  border-radius: 12rpx;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.78), rgba(255, 252, 242, 0.94)),
    #f5ead2;
}

.bottom-publish-strip::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -8rpx;
  height: 16rpx;
  background: repeating-linear-gradient(
    135deg,
    rgba(255, 253, 246, 0.95) 0,
    rgba(255, 253, 246, 0.95) 18rpx,
    transparent 18rpx,
    transparent 30rpx
  );
}

.publish-doodle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 86rpx;
  color: var(--ink-green);
  font-size: 42rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.publish-doodle text {
  position: absolute;
  width: 42rpx;
  height: 42rpx;
}

.publish-doodle text:nth-child(1) {
  left: 0;
  top: 0;
}

.publish-doodle text:nth-child(2) {
  left: 28rpx;
  bottom: 0;
  width: 62rpx;
  height: 62rpx;
  font-size: 58rpx;
  transform: rotate(-10deg);
}

.publish-doodle text:nth-child(3) {
  right: 6rpx;
  top: 8rpx;
}

.bottom-publish-strip .publish-title {
  font-size: 40rpx;
}

.bottom-publish-strip .hero-action {
  min-width: 170rpx;
  min-height: 82rpx;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: inset 0 -5rpx 0 rgba(121, 84, 0, 0.12), 0 10rpx 20rpx rgba(177, 126, 0, 0.2);
}

/* ===== Category Grid ===== */
.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18rpx 16rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.category-board-label {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  min-height: 58rpx;
  margin-top: 4rpx;
  padding: 0 24rpx;
  border-radius: 6rpx;
  color: #ffffff;
  background: var(--ink-green);
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 16rpx rgba(35, 58, 43, 0.14);
  transform: rotate(-1.4deg);
}

.category-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 152rpx;
  padding: 18rpx 8rpx 16rpx;
  border: 1rpx solid #e8ddc8;
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 253, 246, 0.98)),
    #fffdf6;
  box-shadow: 0 7rpx 12rpx rgba(77, 62, 38, 0.12);
  font-size: 24rpx;
  font-weight: 800;
  transform: rotate(-0.6deg);
}

.category-item:nth-child(2n) {
  transform: rotate(0.8deg);
}

.category-item::before {
  content: "";
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 36rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(8, 114, 77, 0.2);
  transform: translateX(-50%);
}

.category-item .cat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 10rpx;
  color: var(--ink-green);
  background: #dff3df;
  font-size: 32rpx;
  font-weight: 700;
  background-size: 42rpx 42rpx;
}

.cat-books {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%2308784f' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M14 15h16c5 0 8 3 8 8v26c0-5-3-8-8-8H14V15z' fill='%23fffdf6'/%3E%3Cpath d='M50 15H38c-5 0-8 3-8 8v26c0-5 3-8 8-8h12V15z' fill='%23fff4bf'/%3E%3Cpath d='M20 25h10M20 33h9M40 25h5M40 33h5'/%3E%3C/g%3E%3C/svg%3E");
