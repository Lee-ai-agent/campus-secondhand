/* ===== Design Tokens ===== */
page {
  --market-green: #19b45b;
  --market-deep: #0068e8;
  --market-yellow: #007aff;
  --market-red: #ff2d2f;
  --market-blue: #007aff;
  --market-paper: #f5f6f8;
  --market-ink: #111111;
  --market-muted: #6b7280;
  --market-line: #e5e7eb;
  --market-panel: #ffffff;
  --paper-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  --ink-green: #007aff;
  --chalk-green: #007aff;
  --tape: rgba(0, 122, 255, 0.12);
  --shadow-soft: 0 10rpx 28rpx rgba(15, 23, 42, 0.08);
  --shadow-card: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
  --shadow-float: 0 14rpx 28rpx rgba(15, 23, 42, 0.12);
  --shadow-heavy: 0 18rpx 34rpx rgba(0, 122, 255, 0.2);
  --radius-sm:  12rpx;
  --radius-md:  20rpx;
  --radius-lg:  28rpx;
  --radius-full: 999rpx;
  --bg: var(--market-paper);
  --card: var(--market-panel);
  --text: var(--market-ink);
  --text-muted: var(--market-muted);
  --line: var(--market-line);
  --primary: var(--market-green);
  --primary-bg: #e8f2ff;
  --red: var(--market-red);
  --green: var(--market-green);
  --orange: var(--market-yellow);
  --fill: #f8fafc;
  --space-1:  8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --fs-xs: 20rpx;
  --fs-sm: 24rpx;
  --fs-md: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 36rpx;
  --fs-2xl: 44rpx;

  background: var(--market-paper);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-md);
  line-height: 1.5;
}

/* ===== Layout ===== */
.page {
  min-height: 100vh;
  padding: 0 26rpx 34rpx;
  box-sizing: border-box;
  gap: 18rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-2);
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

/* ===== Cards ===== */
.card {
  background: var(--card);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--line);
}

.screen-card {
  background: var(--card);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--line);
}

/* ===== Typography ===== */
.muted {
  color: var(--text-muted);
  font-size: var(--fs-sm);
}

.price {
  color: var(--red);
  font-size: var(--fs-xl);
  font-weight: 700;
  letter-spacing: 0;
}

.name {
  font-size: var(--fs-lg);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 var(--space-2);
  border-radius: var(--radius-full);
  color: var(--primary);
  background: var(--primary-bg);
  font-size: var(--fs-xs);
  font-weight: 600;
}

/* ===== Buttons ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-full);
  background: var(--card);
  color: var(--text);
  font-weight: 600;
  font-size: var(--fs-md);
  transition: opacity 150ms ease-out;
}

.btn:active {
  opacity: 0.6;
}

.btn.primary {
  border-color: transparent;
  color: #ffffff;
  background: var(--primary);
  box-shadow: 0 8rpx 18rpx rgba(0, 122, 255, 0.18);
}

.btn.ghost {
  color: var(--primary);
  background: var(--primary-bg);
  border-color: transparent;
}

.btn.danger {
  border-color: transparent;
  color: #FFFFFF;
  background: var(--red);
}

.btn.small {
  min-height: 60rpx;
  padding: 0 20rpx;
  font-size: var(--fs-sm);
}

/* ===== Badge / Status ===== */
.badge {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.badge.success {
  color: var(--market-deep);
  background: #e8f6ee;
}

.badge.warn {
  color: #8c6414;
  background: #fff4cb;
}

.badge.danger {
  color: var(--market-red);
  background: #ffeceb;
}

.badge.blue {
  color: var(--primary);
  background: var(--primary-bg);
}

/* ===== Tags ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--fill);
  color: var(--text-muted);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.tag.active {
  background: var(--market-deep);
  color: #FFFFFF;
}

/* ===== Inputs ===== */
.input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--fill);
  box-sizing: border-box;
  font-size: var(--fs-md);
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx var(--space-3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--fill);
  box-sizing: border-box;
  font-size: var(--fs-md);
}

/* ===== Form ===== */
.form-card {
  background: var(--card);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--line);
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-bottom: 20rpx;
}

.field-label {
  color: var(--text-muted);
  font-size: var(--fs-sm);
  font-weight: 600;
}

/* ===== Search Bar ===== */
.home-search-row {
  position: sticky;
  top: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.soft-search {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 16rpx;
  min-height: 90rpx;
  padding: 12rpx 14rpx 12rpx 22rpx;
  border: 0;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 10rpx 24rpx rgba(29, 41, 34, 0.15);
}

.soft-search .search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid var(--ink-green);
  border-radius: 50%;
  color: var(--ink-green);
  background: transparent;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.soft-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
}

.soft-search .search-action {
  flex-shrink: 0;
  min-width: 122rpx;
  min-height: 66rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 28rpx;
  color: var(--market-deep);
  background: var(--market-yellow);
  box-shadow: inset 0 -5rpx 0 rgba(121, 84, 0, 0.12), 0 8rpx 16rpx rgba(177, 126, 0, 0.16);
  font-weight: 600;
  font-size: 26rpx;
}

.home-search-row .soft-search .search-action {
  display: none;
}

.top-sell-btn {
  flex-shrink: 0;
  min-width: 152rpx;
  min-height: 88rpx;
  gap: 8rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: inset 0 -5rpx 0 rgba(121, 84, 0, 0.12), 0 10rpx 20rpx rgba(177, 126, 0, 0.2);
}

.sell-camera {
  display: inline-flex;
  width: 30rpx;
  height: 30rpx;
  font-size: 30rpx;
  line-height: 1;
}

.inline-svg {
  display: inline-flex;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.svg-search {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%2308784f' stroke-width='6' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='28' cy='28' r='13'/%3E%3Cpath d='M39 39l12 12'/%3E%3Cpath d='M24 28c0-3 2-5 5-5' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E");
}

