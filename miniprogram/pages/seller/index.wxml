<view class="page stack">
  <view class="banner" style="background:linear-gradient(135deg,#0c5c42,#18a66b)">
    <text class="banner-kicker">个人摊位</text>
    <h3>我的校园摊位</h3>
    <p>发布闲置、看审核、处理卖出订单都在这里。</p>
  </view>

  <view class="profile-stats">
    <view class="stat-item">
      <text class="stat-num">12</text><text class="stat-label">发布</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">2</text><text class="stat-label">待发货</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">3</text><text class="stat-label">咨询</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">8</text><text class="stat-label">成交</text>
    </view>
  </view>

  <view class="grid-2">
    <view class="category-item" bindtap="goPublish">
      <view class="cat-icon">📦</view>
      <text>发布闲置</text>
    </view>
    <view class="category-item" bindtap="goPosts">
      <view class="cat-icon">📋</view>
      <text>我的发布</text>
    </view>
    <view class="category-item" bindtap="goOrders">
      <view class="cat-icon">📦</view>
      <text>卖出订单</text>
    </view>
    <view class="category-item" bindtap="goShop">
      <view class="cat-icon">🏪</view>
      <text>店铺资料</text>
    </view>
  </view>
</view>
