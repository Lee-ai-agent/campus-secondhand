<view class="page stack">
  <view class="banner">
    <text class="banner-kicker">发布</text>
    <h3>今天想发布什么？</h3>
    <p>选择发布闲置或发求购，具体表单会在下一步填写。</p>
  </view>

  <view class="grid-2">
    <view class="category-item publish-entry sell-entry" bindtap="goPublish">
      <view class="cat-icon">＋</view>
      <text>发布闲置</text>
      <text class="muted">出售教材、数码、生活用品</text>
    </view>
    <view class="category-item publish-entry wanted-entry" bindtap="goWantedPublish">
      <view class="cat-icon">⌕</view>
      <text>发求购</text>
      <text class="muted">让同学主动联系你</text>
    </view>
  </view>

  <view class="profile-section">
    <text class="section-label">最近草稿</text>
    <text class="muted">暂无草稿</text>
  </view>

  <view class="profile-section">
    <text class="section-label">发布管理</text>
    <view class="grid-2">
      <view class="category-item" bindtap="goPosts">
        <view class="cat-icon">L</view>
        <text>我的发布</text>
      </view>
    <view class="category-item" bindtap="goOrders">
      <view class="cat-icon">O</view>
      <text>卖出订单</text>
    </view>
    </view>
  </view>
</view>
