<view class="page" style="padding:0">
  <view class="section-title" style="padding:24rpx 24rpx 0">
    <view>
      <text style="font-size:32rpx;font-weight:700">消息</text>
      <text class="muted">长按会话可置顶或删除</text>
    </view>
  </view>
  <block wx:for="{{messages}}" wx:key="id">
    <view class="message-row" bindtap="openChat" data-id="{{item.id}}">
      <view class="message-avatar">{{item.senderNickname ? item.senderNickname[0] : '同'}}</view>
      <view class="message-main">
        <view class="message-line">
          <text class="msg-name">会话 #{{item.id}}</text>
          <text class="msg-time">{{item.sentAt || '最近'}}</text>
        </view>
        <view class="message-preview">{{item.content}}</view>
        <text wx:if="{{item.status === 'UNREAD'}}" class="message-unread">未读</text>
      </view>
    </view>
  </block>
  <view wx:if="{{messages.length === 0}}" class="empty-state" style="margin:24rpx">
    <view class="empty-icon">M</view>
    <text class="empty-title">暂无咨询消息</text>
    <text class="empty-desc">商品详情页里联系卖家后可在这里继续对话。</text>
  </view>
</view>
