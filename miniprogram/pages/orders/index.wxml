<view class="page stack">
  <view class="status-tabs">
    <view class="tab active">全部</view>
    <view class="tab">待付款</view>
    <view class="tab">待发货</view>
    <view class="tab">售后</view>
  </view>
  <block wx:for="{{orders}}" wx:key="id">
    <view class="order-card">
      <view class="order-row">
        <text style="font-weight:700;font-size:30rpx">{{item.orderNo || ('SO' + item.id)}}</text>
        <text class="badge {{item.status === 'pending_payment' ? 'warn' : item.status === 'completed' ? 'success' : 'blue'}}">{{statusText[item.status] || item.status}}</text>
      </view>
      <text class="muted">商品 #{{item.productId}} · 数量 {{item.quantity}}</text>
      <view class="order-row">
        <text class="price" style="font-size:32rpx">¥{{item.totalAmount}}</text>
      </view>
      <view class="order-actions">
        <view wx:if="{{item.status === 'pending_payment'}}" class="btn primary small" bindtap="pay" data-id="{{item.id}}">去付款</view>
        <view wx:if="{{item.status === 'pending_receipt'}}" class="btn primary small" bindtap="receive" data-id="{{item.id}}">确认收货</view>
        <view class="btn small" bindtap="viewDetail" data-id="{{item.id}}">查看详情</view>
      </view>
    </view>
  </block>
  <view wx:if="{{orders.length === 0}}" class="empty-state">
    <view class="empty-icon">O</view>
    <text class="empty-title">暂无订单</text>
    <text class="empty-desc">去首页看看有什么好东西。</text>
    <button class="btn primary" bindtap="goHome">去首页</button>
  </view>
</view>
