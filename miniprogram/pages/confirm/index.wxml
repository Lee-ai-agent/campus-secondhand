<view class="page stack" style="padding-bottom:120rpx">
  <view class="address-card" bindtap="goAddress">
    <view style="font-size:40rpx">⌖</view>
    <view style="flex:1">
      <text style="display:block;font-weight:700;font-size:28rpx">{{receiverName}} {{receiverPhone}}</text>
      <text class="muted">{{receiverAddress}}</text>
    </view>
    <text style="color:var(--primary);font-weight:700">更换</text>
  </view>

  <view class="product-card">
    <view class="product-img" data-kind="教材资料">
      <view class="product-mark">教</view>
      <text>教材资料</text>
    </view>
    <view class="product-info">
      <text class="title">{{productTitle}}</text>
      <text class="muted">数量 1</text>
      <text class="muted">面交点 {{pickupLocation}}</text>
    </view>
  </view>

  <view class="field">
    <text class="field-label">订单备注</text>
    <textarea class="textarea" placeholder="今晚 18:00 后方便自提" value="{{remark}}" bindinput="onRemark" />
  </view>

  <view class="screen-card">
    <text class="section-label">模拟支付说明</text>
    <text class="muted">提交后生成待付款订单，可在订单详情或聊天会话内完成模拟付款。</text>
  </view>

  <view class="bottom-action-bar">
    <view>
      <text class="muted">应付</text>
      <text class="price">¥{{totalPrice}}</text>
    </view>
    <button class="btn primary" bindtap="submitOrder">提交订单</button>
  </view>
</view>
