<view class="page stack" style="padding-bottom:120rpx">
  <view class="address-card">
    <view style="font-size:40rpx">⌖</view>
    <view style="flex:1">
      <view class="row">
        <text style="font-weight:700;font-size:28rpx">李同学</text>
        <text class="badge">默认</text>
      </view>
      <text class="muted" style="display:block">13800000000</text>
      <text class="muted">东区 3 栋 501</text>
    </view>
  </view>

  <view class="form-card">
    <text style="font-weight:700;font-size:30rpx;display:block;margin-bottom:16rpx">新增地址</text>
    <view class="field">
      <text class="field-label">姓名</text>
      <input class="input" value="{{name}}" bindinput="onName" placeholder="李同学" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" value="{{phone}}" bindinput="onPhone" placeholder="13800000000" />
    </view>
    <view class="field">
      <text class="field-label">详细地址</text>
      <input class="input" value="{{address}}" bindinput="onAddress" placeholder="东区 3 栋 501" />
    </view>
  </view>

  <view class="bottom-action-bar">
    <button class="btn primary" bindtap="saveAddress">保存地址</button>
  </view>
</view>
