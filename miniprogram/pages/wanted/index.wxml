<view class="page stack page-enter wanted-page">
  <view class="wanted-hero">
    <view class="chalk-board">
      <view class="tape tape-left"></view>
      <view class="paper-note">校园二手</view>
      <text class="wanted-hero-title">求购专区</text>
      <text class="wanted-hero-sub">同学们正在找</text>
      <view class="chalk-icon">⌕</view>
      <view class="chalk-line line-a"></view>
      <view class="chalk-line line-b"></view>
    </view>
  </view>

  <view class="filter-row">
    <view class="filter-chip active">
      <text class="chip-label">排序</text>
      <text class="chip-value">最新发布</text>
    </view>
    <view class="filter-chip">
      <text class="chip-label">预算</text>
      <text class="chip-value">全部预算</text>
    </view>
    <view class="filter-chip">
      <text class="chip-label">成色</text>
      <text class="chip-value">全部要求</text>
    </view>
  </view>

  <block wx:for="{{posts}}" wx:key="id">
    <view class="wanted-card" bindtap="viewDetail" data-id="{{item.id}}">
      <view class="card-tape"></view>
      <view class="wanted-thumb">求</view>
      <view class="wanted-main">
        <view class="row">
          <text class="wanted-title">{{item.title}}</text>
          <text class="badge success">{{item.conditionLevel}}</text>
        </view>
        <text class="wanted-budget">预算 ¥{{item.minPrice}}-{{item.maxPrice}}</text>
        <text class="muted">{{item.description}}</text>
        <view class="wanted-meta-row">
          <text class="wanted-meta-tag">{{item.userNickname || '同学'}}</text>
          <text class="wanted-meta-tag">{{item.status || '寻找中'}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{posts.length === 0}}" class="empty-state">
    <view class="empty-icon">⌕</view>
    <text class="empty-title">暂无求购</text>
    <text class="empty-desc">还没有同学发布求购，可以先发起一个需求。</text>
    <button class="btn primary" bindtap="goPublish">发起求购</button>
  </view>

  <view class="floating-action" bindtap="goPublish">
    <text>+</text>
    <text>发求购</text>
  </view>
</view>
