<view class="page stack page-enter detail-page" wx:if="{{product}}">
  <view class="mini-top detail-top">
    <text class="brand-title">校园二手</text>
  </view>

  <view class="product-visual">
    <view class="tape tape-left"></view>
    <view class="tape tape-right"></view>
    <view class="recommend-note">好物推荐</view>
    <view class="product-mark">{{product.categoryName === '教材资料' ? '教' : product.categoryName === '数码电子' ? '数' : product.categoryName === '生活用品' ? '生' : '物'}}</view>
    <view class="photo-caption">{{product.categoryName}}</view>
    <view class="desk-shadow"></view>
    <view class="trust-sticker">
      <text>相信同学</text>
      <text>真实靠谱</text>
    </view>
  </view>

  <view class="screen-card stack paper-card">
    <view class="row">
      <text class="name hero-title">{{product.title}}</text>
      <view wx:if="{{!canBuy}}" class="badge danger">{{product.status === 'sold' ? '已卖出' : '已下架'}}</view>
    </view>
    <view class="row">
      <text class="price">¥{{product.price}}</text>
      <view class="badge success">{{product.conditionLevel}}</view>
    </view>
    <text class="muted">{{product.pickupLocation}} · 发布者 {{product.sellerNickname || '同学'}}</text>
    <text>{{product.description}}</text>
    <view class="link-row" bindtap="goWanted">
      <text>想要类似商品</text>
      <text class="section-label">去求购 →</text>
    </view>
  </view>

  <view class="seller-card">
    <view class="profile-avatar">{{product.sellerNickname ? product.sellerNickname[0] : '同'}}</view>
    <view class="action-grow">
      <text class="section-label">{{product.sellerNickname || '同学'}}</text>
      <view class="muted">校内当面交易 · {{product.pickupLocation}}</view>
    </view>
    <view class="badge success">学生认证</view>
    <view class="cert-stamp">✓</view>
  </view>

  <view class="bottom-action-bar">
    <button class="favorite-action" bindtap="toggleFavorite">
      {{favorite ? '♥' : '♡'}}
    </button>
    <button class="btn ghost action-grow" bindtap="sendMessage">聊一聊</button>
    <button class="btn primary action-grow" bindtap="buyNow" disabled="{{!canBuy}}">立即购买</button>
  </view>
</view>
