<view class="page stack page-enter profile-page">
  <view class="mini-top">
    <text class="brand-title">个人中心</text>
  </view>

  <view class="profile-hero">
    <view class="campus-line"></view>
    <view class="awning">
      <view></view><view></view><view></view><view></view>
    </view>
    <view class="profile-avatar">{{user ? user.nickname[0] : '游'}}</view>
    <view class="action-grow">
      <text class="hero-title">{{user ? user.nickname : '游客'}}</text>
      <text class="muted">{{user ? user.role : '登录后可下单、发布和查看订单'}}</text>
    </view>
    <text wx:if="{{user}}" class="badge">已登录</text>
    <view class="stall-sign">
      <text>校园</text>
      <text>二手</text>
    </view>
  </view>

  <view wx:if="{{!user}}">
    <button class="btn primary login-action" bindtap="login">登录</button>
  </view>

  <view wx:if="{{user}}">
    <view class="profile-stats">
      <view class="stat-item">
        <view class="stat-icon">▢</view><text class="stat-num">-</text><text class="stat-label">买入</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon">✈</view><text class="stat-num">-</text><text class="stat-label">发布</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon">￥</view><text class="stat-num">-</text><text class="stat-label">卖出</text>
      </view>
      <view class="stat-item">
        <view class="stat-icon">⌕</view><text class="stat-num">-</text><text class="stat-label">求购</text>
      </view>
    </view>

    <view class="profile-section">
      <text class="section-label">交易</text>
      <view class="grid-2">
        <view class="category-item" bindtap="orders">
          <view class="cat-icon">B</view>
          <text>买入订单</text>
        </view>
        <view class="category-item" bindtap="goWanted">
          <view class="cat-icon">⌕</view>
          <text>我的求购</text>
        </view>
      </view>
    </view>

    <view class="profile-section">
      <view class="row">
        <text class="section-label">我的校园摊位</text>
        <button class="btn primary small" bindtap="goSeller">卖闲置</button>
      </view>
      <view class="grid-2">
        <view class="category-item" bindtap="goPosts">
          <view class="cat-icon">P</view>
          <text>我的发布</text>
        </view>
        <view class="category-item" bindtap="goSellerOrders">
          <view class="cat-icon">O</view>
          <text>卖出订单</text>
        </view>
      </view>
    </view>

    <view class="profile-section">
      <text class="section-label">工具</text>
      <view class="grid-2">
        <view class="category-item" bindtap="goFavorites">
          <view class="cat-icon">★</view>
          <text>收藏</text>
        </view>
        <view class="category-item" bindtap="goAddress">
          <view class="cat-icon">⌖</view>
          <text>地址</text>
        </view>
      </view>
    </view>

    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
